{
	"$schema": "https://json.schemastore.org/chrome-manifest",
	"name": "No More Doodle extension",
	"version": "25.9.14",
	"description": "Fills up your doodle instantly, using native calendar information",
	"homepage_url": "https://github.com/bpiwowar/nomoredoodle",
	"manifest_version": 3,
	"minimum_chrome_version": "121",
	"key": "",
	"browser_specific_settings": {
		"gecko": {
			"id": "no-more-doodle@piwowarski.fr",
			"strict_min_version": "109.0"
		}
	},
	"icons": {
		"128": "icon.png"
	},
	"permissions": [
		"nativeMessaging",
		"storage",
		"tabs",
		"activeTab",
		"notifications"
	],
	"host_permissions": [
		"*://doodle.com/*",
		"*://evento.renater.fr/*"
	],
	"content_scripts": [
		{
			"matches": [
				"https://doodle.com/*"
			],
			"js": [
				"sites/doodle.ts"
			],
			"css": [
			],
			"run_at": "document_end"
		},
		{
			"matches": [
				"https://evento.renater.fr/survey/*"
			],
			"js": [
				"sites/evento.ts"
			],
			"css": [
			],
			"run_at": "document_end"
		}
	],
	"background": {
		"service_worker": "background.ts",
		"type": "module"
	},
	"action": {
		"default_popup": "popup.html",
		"default_title": "Select Calendars"
	}
}
