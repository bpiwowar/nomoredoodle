{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
		"jsx": "react-jsx",
    "moduleResolution": "node",
    "sourceMap": true,
    "noEmit": true,
		"types": [
			"firefox-webext-browser",
			"chrome",
			"node"
		]
  },
  "include": ["source/**/*.ts", "source/**/*.tsx", "test/**/*.ts"]
}
